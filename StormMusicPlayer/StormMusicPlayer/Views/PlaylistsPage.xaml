<Page
    x:Class="StormMusicPlayer.Views.PlaylistsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Padding="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Page Title Area -->
            <RowDefinition Height="*"/>    <!-- Playlists split panel -->
        </Grid.RowDefinitions>

        <!-- Page Header block -->
        <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,16">
            <TextBlock Text="ПЛЕЙЛИСТЫ" Style="{StaticResource StormHeaderLargeStyle}"/>
            <TextBlock Text="УПРАВЛЕНИЕ МУЗЫКАЛЬНЫМИ ПОДБОРКАМИ" Style="{StaticResource StormTextSubtleBoldStyle}" Foreground="{StaticResource AccentColorBrush}"/>
        </StackPanel>

        <!-- Playlists split panel -->
        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/> <!-- Playlists selection list -->
                <ColumnDefinition Width="*"/>   <!-- Active playlist tracks -->
            </Grid.ColumnDefinitions>

            <!-- Playlists List Column (Left Pane) -->
            <Border Grid.Column="0" CornerRadius="20" Background="{ThemeResource PlayerCardBackgroundBrush}" BorderThickness="1.5" BorderBrush="{ThemeResource PlayerCardBorderBrush}" Margin="0,0,20,0" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="ВАШИ ПОДБОРКИ" Style="{StaticResource StormTextBoldStyle}" Margin="4,0,0,12" Grid.Row="0"/>

                    <ListView x:Name="PlaylistsListView" Grid.Row="1" SelectionMode="Single" SelectionChanged="OnPlaylistSelectionChanged">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="12,10,12,10"/>
                                <Setter Property="Margin" Value="0,3,0,3"/>
                                <Setter Property="CornerRadius" Value="10"/>
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8B7;" FontSize="18" Foreground="{ThemeResource AccentColorBrush}" VerticalAlignment="Center" Margin="0,0,12,0" Grid.Column="0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource StormTextBoldStyle}" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="Плейлист" Style="{StaticResource StormTextSubtleBoldStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Button Click="OnCreatePlaylistClick" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Margin="0,12,0,0" Grid.Row="2" CornerRadius="8" Height="40">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE109;" FontSize="14"/>
                            <TextBlock Text="Создать плейлист" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Tracks in Selected Playlist Column (Right Pane) -->
            <Border Grid.Column="1" CornerRadius="20" Background="{ThemeResource PlayerCardBackgroundBrush}" BorderThickness="1.5" BorderBrush="{ThemeResource PlayerCardBorderBrush}" Padding="20">
                <Grid x:Name="PlaylistDetailsPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Title & Play All -->
                        <RowDefinition Height="*"/>    <!-- Tracks -->
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock x:Name="SelectedPlaylistNameText" Text="ИМЯ ПЛЕЙЛИСТА" Style="{StaticResource StormHeaderMediumStyle}"/>
                            <TextBlock x:Name="TracksCountText" Text="0 треков" Style="{StaticResource StormTextSubtleBoldStyle}"/>
                        </StackPanel>

                        <Button Click="OnPlayAllClick" Grid.Column="1" Style="{StaticResource AccentButtonStyle}" Height="40" Padding="16,0,16,0" CornerRadius="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE102;" FontSize="14"/>
                                <TextBlock Text="Слушать всё" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <ListView x:Name="PlaylistTracksListView" Grid.Row="1" SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="16,10,16,10"/>
                                <Setter Property="Margin" Value="0,4,0,4"/>
                                <Setter Property="CornerRadius" Value="12"/>
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Cover Art bind/placeholder -->
                                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="8" Background="#101010" BorderBrush="{ThemeResource PlayerCardBorderBrush}" BorderThickness="1.5" HorizontalAlignment="Left">
                                        <Grid>
                                            <Image Source="{Binding CoverImagePath}" Stretch="UniformToFill"/>
                                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE189;" FontSize="16" Foreground="DimGray" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <!-- Title -->
                                    <TextBlock Text="{Binding Title}" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource StormTextBoldStyle}" Margin="12,0,12,0" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

                                    <!-- Artist -->
                                    <TextBlock Text="{Binding Artist}" Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource StormTextSubtleBoldStyle}" Foreground="{ThemeResource AccentColorBrush}" Margin="0,0,12,0"/>

                                    <!-- Delete Action (Transparent red bin icon button) -->
                                    <Button Click="OnRemoveTrackClick" Tag="{Binding}" Grid.Column="3" Width="36" Height="36" CornerRadius="18" Background="Transparent" BorderThickness="1" BorderBrush="{ThemeResource PlayerCardBorderBrush}" ToolTipService.ToolTip="Удалить из плейлиста">
                                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE108;" FontSize="12" Foreground="Red"/>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
