<Page
    x:Class="StormMusicPlayer.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Global Branding Header Area -->
            <RowDefinition Height="*"/>    <!-- Main View Workspace -->
        </Grid.RowDefinitions>

        <!-- Top branding titlebar matching Fluent overlay -->
        <Grid Grid.Row="0" Padding="20,14,20,14" Background="{ThemeResource SystemControlBackgroundChromeBlurryBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- STORM MUSIC PLAYER OFFICIAL BRANDING (Century Gothic BOLD) -->
            <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                <TextBlock 
                    Text="STORM MUSIC PLAYER" 
                    Style="{StaticResource StormHeaderLargeStyle}"
                    Foreground="{StaticResource AccentColorBrush}" />
                <TextBlock 
                    Text="0.0.1" 
                    Style="{StaticResource StormTextSubtleBoldStyle}" 
                    Margin="12,10,0,0" 
                    VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Sidebar Navigation shell -->
        <NavigationView 
            Grid.Row="1" 
            x:Name="ShellNavigationView"
            PaneDisplayMode="LeftCompact"
            IsSettingsVisible="True"
            SelectionChanged="OnNavigationSelectionChanged"
            FontFamily="Century Gothic"
            FontWeight="Bold">
            
            <NavigationView.MenuItems>
                <!-- NavigationView items strictly using Bold labels and standard SymbolIcons -->
                <NavigationViewItem Content="Сейчас играет" Tag="NowPlaying" FontFamily="Century Gothic" FontWeight="Bold">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Play" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Медиатека" Tag="Library" FontFamily="Century Gothic" FontWeight="Bold">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Audio" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Плейлисты" Tag="Playlists" FontFamily="Century Gothic" FontWeight="Bold">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="MusicInfo" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Эквалайзер" Tag="Equalizer" FontFamily="Century Gothic" FontWeight="Bold">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Equalizer" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Студия визуализации" Tag="Visualizer" FontFamily="Century Gothic" FontWeight="Bold">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Pictures" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" Margin="16"/>
        </NavigationView>
    </Grid>
</Page>

