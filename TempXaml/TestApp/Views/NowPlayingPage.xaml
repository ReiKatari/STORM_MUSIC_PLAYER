<Page
    x:Class="StormMusicPlayer.Views.NowPlayingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:StormMusicPlayer.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>         <!-- Dynamic GPU visualizer zone -->
            <ColumnDefinition Width="420"/>       <!-- Integrated media controller card -->
        </Grid.ColumnDefinitions>

        <!-- Dynamic GPU-Accelerated rendering zone (Circular Waveform mode) -->
        <Grid Grid.Column="0" Padding="16">
            <controls:VisualizerControl x:Name="ActiveVisualizer" EffectIndex="1" Sensitivity="2.2" />
        </Grid>

        <!-- Media playback dashboard panel -->
        <Border Grid.Column="1" Margin="16" CornerRadius="20" Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}">
            <StackPanel Padding="28" Spacing="20" VerticalAlignment="Center">
                
                <!-- Circular/Rounded cover art wrapper -->
                <Border Width="300" Height="300" CornerRadius="16" BorderThickness="1.5" BorderBrush="#3C3C3C" HorizontalAlignment="Center">
                    <Grid Background="Black">
                        <SymbolIcon Symbol="MusicInfo" FontSize="110" Foreground="DimGray"/>
                    </Grid>
                </Border>

                <!-- Track/Artist Info blocks (Century Gothic BOLD labels) -->
                <StackPanel Spacing="6" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <TextBlock Text="ШТОРМОВОЙ ВЕК" Style="{StaticResource StormHeaderMediumStyle}" HorizontalAlignment="Center" />
                    <TextBlock Text="STORM SYSTEM" Style="{StaticResource StormTextBoldStyle}" Foreground="{StaticResource AccentColorBrush}" HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Custom slider for timeline progression -->
                <Slider Minimum="0" Maximum="320" Value="145" HorizontalAlignment="Stretch" Margin="0,16,0,0"/>

                <!-- Primary Player controls with custom buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="28" Margin="0,8,0,0">
                    <Button Content="⏮" Width="52" Height="52" CornerRadius="26"/>
                    <Button Content="▶" Width="64" Height="64" CornerRadius="32" Background="{StaticResource AccentColorBrush}" Foreground="White"/>
                    <Button Content="⏭" Width="52" Height="52" CornerRadius="26"/>
                </StackPanel>

                <!-- Volume configuration block -->
                <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <SymbolIcon Symbol="Volume" Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center"/>
                    <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="75" VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Page>

