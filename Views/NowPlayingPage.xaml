<Page
    x:Class="StormMusicPlayer.Views.NowPlayingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:StormMusicPlayer.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent"
    SizeChanged="OnSizeChanged">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Fullscreen GPU-Accelerated rendering zone (Visualizer is full page background) -->
        <Grid Grid.Row="0" Grid.Column="0" Margin="0">
            <controls:VisualizerControl x:Name="ActiveVisualizer" EffectIndex="1" Sensitivity="2.2" />
            <Border Background="{ThemeResource VisualizerOverlayBrush}"/>
        </Grid>

        <!-- 1. WIDE MODE CONTENT LAYOUT (Side-by-Side Dashboard) -->
        <Grid x:Name="WideContentGrid" Grid.Row="0" Grid.Column="0" Visibility="Visible" Margin="40">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />     <!-- Left: Cover Art -->
                <ColumnDefinition Width="1.2*" />   <!-- Right: Dashboard Card -->
            </Grid.ColumnDefinitions>

            <!-- Large Premium Cover Art Card with elegant glowing borders -->
            <Grid Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,32,0">
                <Border Width="320" Height="320" CornerRadius="24" BorderThickness="2" BorderBrush="{ThemeResource PlayerCardBorderBrush}" Background="#101010" Padding="0">
                    <Grid CornerRadius="22">
                        <Image x:Name="WideCoverImage" Stretch="UniformToFill"/>
                        <FontIcon x:Name="WideDefaultCoverIcon" FontFamily="Segoe MDL2 Assets" Glyph="&#xE189;" FontSize="110" Foreground="DimGray"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Glassmorphic playback dashboard panel -->
            <Border x:Name="WideControlCard" Grid.Column="1" CornerRadius="24" Background="{ThemeResource PlayerCardBackgroundBrush}" BorderThickness="1.5" BorderBrush="{ThemeResource PlayerCardBorderBrush}" Padding="32" VerticalAlignment="Center" HorizontalAlignment="Stretch" MaxWidth="500">
                <StackPanel Spacing="18">
                    <!-- Title/Artist Information -->
                    <StackPanel Spacing="6" HorizontalAlignment="Left">
                        <TextBlock x:Name="WideTrackTitleText" Text="ШТОРМОВОЙ ВЕК" Style="{StaticResource StormHeaderLargeStyle}" HorizontalAlignment="Left" TextWrapping="Wrap" MaxLines="2" />
                        <TextBlock x:Name="WideArtistNameText" Text="STORM SYSTEM" Style="{StaticResource StormTextBoldStyle}" Foreground="{ThemeResource AccentColorBrush}" HorizontalAlignment="Left" />
                    </StackPanel>

                    <!-- Premium Inline Visualizer Selector -->
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="ВИЗУАЛИЗАЦИЯ:" Style="{StaticResource StormTextSubtleBoldStyle}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <ComboBox x:Name="WideVisualizerPicker" Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="1" SelectionChanged="OnVisualizerPickerSelectionChanged" FontFamily="Century Gothic" FontWeight="Bold">
                            <ComboBoxItem Content="Classic Spectrum" FontFamily="Century Gothic" FontWeight="Bold"/>
                            <ComboBoxItem Content="Circular Waveform" FontFamily="Century Gothic" FontWeight="Bold"/>
                            <ComboBoxItem Content="Retro VU Meters" FontFamily="Century Gothic" FontWeight="Bold"/>
                            <ComboBoxItem Content="Neon Ribbon Trails" FontFamily="Century Gothic" FontWeight="Bold"/>
                            <ComboBoxItem Content="Particle Vortex" FontFamily="Century Gothic" FontWeight="Bold"/>
                        </ComboBox>
                    </Grid>

                    <!-- Custom Timeline progression -->
                    <StackPanel Spacing="4" Margin="0,4,0,0">
                        <Slider x:Name="WideTimelineSlider" Minimum="0" Maximum="100" Value="0" HorizontalAlignment="Stretch" ValueChanged="OnTimelineSliderValueChanged"/>
                        <Grid Margin="0,-4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="WideCurrentTimeText" Text="0:00" Style="{StaticResource StormTextSubtleBoldStyle}" Grid.Column="0" />
                            <TextBlock x:Name="WideTotalTimeText" Text="0:00" Style="{StaticResource StormTextSubtleBoldStyle}" Grid.Column="2" />
                        </Grid>
                    </StackPanel>

                    <!-- Primary Player Controls with MDL2 Icons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="20" Margin="0,8,0,0">
                        <!-- Shuffle button -->
                        <Button x:Name="WideShuffleButton" Click="OnShuffleClick" Width="44" Height="44" CornerRadius="22" Background="Transparent" BorderThickness="0">
                            <FontIcon x:Name="WideShuffleIcon" FontFamily="Segoe MDL2 Assets" Glyph="&#xE14B;" FontSize="16" Foreground="Gray"/>
                        </Button>
                        
                        <!-- Previous button -->
                        <Button Click="OnPrevClick" Width="48" Height="48" CornerRadius="24" Background="Transparent" BorderThickness="0">
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE100;" FontSize="20" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        </Button>
                        
                        <!-- Play/Pause button -->
                        <Button Click="OnPlayPauseClick" Width="60" Height="60" CornerRadius="30" Background="{ThemeResource AccentColorBrush}" BorderThickness="0">
                            <FontIcon x:Name="WidePlayPauseIcon" FontFamily="Segoe MDL2 Assets" Glyph="&#xE102;" FontSize="24" Foreground="White"/>
                        </Button>
                        
                        <!-- Next button -->
                        <Button Click="OnNextClick" Width="48" Height="48" CornerRadius="24" Background="Transparent" BorderThickness="0">
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE101;" FontSize="20" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        </Button>
                        
                        <!-- Repeat button -->
                        <Button x:Name="WideRepeatButton" Click="OnRepeatClick" Width="44" Height="44" CornerRadius="22" Background="Transparent" BorderThickness="0">
                            <FontIcon x:Name="WideRepeatIcon" FontFamily="Segoe MDL2 Assets" Glyph="&#xE1CD;" FontSize="16" Foreground="Gray"/>
                        </Button>
                    </StackPanel>

                    <!-- Volume Config block -->
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <SymbolIcon Symbol="Volume" Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        <Slider x:Name="WideVolumeSlider" Minimum="0" Maximum="100" Value="75" VerticalAlignment="Center" ValueChanged="OnVolumeSliderValueChanged"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 2. NARROW MODE CONTENT LAYOUT (Stacked Scale-Adaptive Card) -->
        <Grid x:Name="NarrowContentGrid" Grid.Row="0" Grid.Column="0" Visibility="Collapsed" Margin="24">
            <Viewbox Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                <Border CornerRadius="24" Background="{ThemeResource PlayerCardBackgroundBrush}" BorderThickness="1.5" BorderBrush="{ThemeResource PlayerCardBorderBrush}" Padding="24" Width="360">
                    <StackPanel Spacing="16">
                        <!-- Scale-adaptive Cover Art wrapper -->
                        <Border Width="220" Height="220" CornerRadius="16" BorderThickness="1.5" BorderBrush="{ThemeResource PlayerCardBorderBrush}" Background="#101010" HorizontalAlignment="Center">
                            <Grid CornerRadius="14">
                                <Image x:Name="NarrowCoverImage" Stretch="UniformToFill"/>
                                <FontIcon x:Name="NarrowDefaultCoverIcon" FontFamily="Segoe MDL2 Assets" Glyph="&#xE189;" FontSize="80" Foreground="DimGray"/>
                            </Grid>
                        </Border>

                        <!-- Track/Artist Info -->
                        <StackPanel Spacing="4" HorizontalAlignment="Center">
                            <TextBlock x:Name="NarrowTrackTitleText" Text="ШТОРМОВОЙ ВЕК" Style="{StaticResource StormHeaderMediumStyle}" HorizontalAlignment="Center" />
                            <TextBlock x:Name="NarrowArtistNameText" Text="STORM SYSTEM" Style="{StaticResource StormTextBoldStyle}" Foreground="{ThemeResource AccentColorBrush}" HorizontalAlignment="Center" />
                        </StackPanel>

                        <!-- Visualizer Picker -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="ЭФФЕКТ:" Style="{StaticResource StormTextSubtleBoldStyle}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <ComboBox x:Name="NarrowVisualizerPicker" Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="1" SelectionChanged="OnVisualizerPickerSelectionChanged" FontFamily="Century Gothic" FontWeight="Bold">
                                <ComboBoxItem Content="Classic Spectrum" FontFamily="Century Gothic" FontWeight="Bold"/>
                                <ComboBoxItem Content="Circular Waveform" FontFamily="Century Gothic" FontWeight="Bold"/>
                                <ComboBoxItem Content="Retro VU Meters" FontFamily="Century Gothic" FontWeight="Bold"/>
                                <ComboBoxItem Content="Neon Ribbon Trails" FontFamily="Century Gothic" FontWeight="Bold"/>
                                <ComboBoxItem Content="Particle Vortex" FontFamily="Century Gothic" FontWeight="Bold"/>
                            </ComboBox>
                        </Grid>

                        <!-- Timeline Progression -->
                        <StackPanel Spacing="4">
                            <Slider x:Name="NarrowTimelineSlider" Minimum="0" Maximum="100" Value="0" HorizontalAlignment="Stretch" ValueChanged="OnTimelineSliderValueChanged"/>
                            <Grid Margin="0,-4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="NarrowCurrentTimeText" Text="0:00" Style="{StaticResource StormTextSubtleBoldStyle}" Grid.Column="0" />
                                <TextBlock x:Name="NarrowTotalTimeText" Text="0:00" Style="{StaticResource StormTextSubtleBoldStyle}" Grid.Column="2" />
                            </Grid>
                        </StackPanel>

                        <!-- Primary Controls -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16">
                            <!-- Shuffle -->
                            <Button x:Name="NarrowShuffleButton" Click="OnShuffleClick" Width="40" Height="40" CornerRadius="20" Background="Transparent" BorderThickness="0">
                                <FontIcon x:Name="NarrowShuffleIcon" FontFamily="Segoe MDL2 Assets" Glyph="&#xE14B;" FontSize="14" Foreground="Gray"/>
                            </Button>
                            
                            <!-- Prev -->
                            <Button Click="OnPrevClick" Width="44" Height="44" CornerRadius="22" Background="Transparent" BorderThickness="0">
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE100;" FontSize="18" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            </Button>
                            
                            <!-- PlayPause -->
                            <Button Click="OnPlayPauseClick" Width="52" Height="52" CornerRadius="26" Background="{ThemeResource AccentColorBrush}" BorderThickness="0">
                                <FontIcon x:Name="NarrowPlayPauseIcon" FontFamily="Segoe MDL2 Assets" Glyph="&#xE102;" FontSize="20" Foreground="White"/>
                            </Button>
                            
                            <!-- Next -->
                            <Button Click="OnNextClick" Width="44" Height="44" CornerRadius="22" Background="Transparent" BorderThickness="0">
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE101;" FontSize="18" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            </Button>
                            
                            <!-- Repeat -->
                            <Button x:Name="NarrowRepeatButton" Click="OnRepeatClick" Width="40" Height="40" CornerRadius="20" Background="Transparent" BorderThickness="0">
                                <FontIcon x:Name="NarrowRepeatIcon" FontFamily="Segoe MDL2 Assets" Glyph="&#xE1CD;" FontSize="14" Foreground="Gray"/>
                            </Button>
                        </StackPanel>

                        <!-- Volume -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <SymbolIcon Symbol="Volume" Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <Slider x:Name="NarrowVolumeSlider" Minimum="0" Maximum="100" Value="75" VerticalAlignment="Center" ValueChanged="OnVolumeSliderValueChanged"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Viewbox>
        </Grid>
    </Grid>
</Page>
