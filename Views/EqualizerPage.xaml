<Page
    x:Class="StormMusicPlayer.Views.EqualizerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Padding="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title/Preset Config Section -->
            <RowDefinition Height="*"/>    <!-- 10 parametric sliders panel -->
        </Grid.RowDefinitions>

        <!-- Dynamic Preset and equalizer activation controls -->
        <StackPanel Grid.Row="0" Spacing="10" Margin="0,0,0,28">
            <TextBlock Text="ЭКВАЛАЙЗЕР" Style="{StaticResource StormHeaderLargeStyle}"/>
            
            <StackPanel Orientation="Horizontal" Spacing="20" Margin="0,12,0,0">
                <!-- Preset selection (Strict BOLD headers and content) -->
                <ComboBox Header="ПРЕСЕТЫ" Width="220" PlaceholderText="ВЫБРАТЬ ПРЕСЕТ" FontFamily="Century Gothic" FontWeight="Bold">
                    <ComboBoxItem Content="Flat" FontFamily="Century Gothic" FontWeight="Bold"/>
                    <ComboBoxItem Content="Рок" FontFamily="Century Gothic" FontWeight="Bold" IsSelected="True"/>
                    <ComboBoxItem Content="Поп" FontFamily="Century Gothic" FontWeight="Bold"/>
                    <ComboBoxItem Content="Джаз" FontFamily="Century Gothic" FontWeight="Bold"/>
                    <ComboBoxItem Content="Классика" FontFamily="Century Gothic" FontWeight="Bold"/>
                    <ComboBoxItem Content="Bass Boost" FontFamily="Century Gothic" FontWeight="Bold"/>
                </ComboBox>

                <ToggleSwitch Header="АКТИВЕН" IsOn="True" VerticalAlignment="Bottom" FontFamily="Century Gothic" FontWeight="Bold"/>
            </StackPanel>
        </StackPanel>

        <!-- 10 Band Parametric sliders -->
        <Grid Grid.Row="1" HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Dynamic frequency channels -->
            <StackPanel Grid.Column="0" HorizontalAlignment="Center" Spacing="10">
                <Slider Orientation="Vertical" Height="320" Minimum="-12" Maximum="12" Value="4.5"/>
                <TextBlock Text="31 Hz" Style="{StaticResource StormTextBoldStyle}" HorizontalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Column="1" HorizontalAlignment="Center" Spacing="10">
                <Slider Orientation="Vertical" Height="320" Minimum="-12" Maximum="12" Value="3"/>
                <TextBlock Text="62 Hz" Style="{StaticResource StormTextBoldStyle}" HorizontalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Column="2" HorizontalAlignment="Center" Spacing="10">
                <Slider Orientation="Vertical" Height="320" Minimum="-12" Maximum="12" Value="1.5"/>
                <TextBlock Text="125 Hz" Style="{StaticResource StormTextBoldStyle}" HorizontalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Column="3" HorizontalAlignment="Center" Spacing="10">
                <Slider Orientation="Vertical" Height="320" Minimum="-12" Maximum="12" Value="0"/>
                <TextBlock Text="250 Hz" Style="{StaticResource StormTextBoldStyle}" HorizontalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Column="4" HorizontalAlignment="Center" Spacing="10">
                <Slider Orientation="Vertical" Height="320" Minimum="-12" Maximum="12" Value="-1"/>
                <TextBlock Text="500 Hz" Style="{StaticResource StormTextBoldStyle}" HorizontalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Column="5" HorizontalAlignment="Center" Spacing="10">
                <Slider Orientation="Vertical" Height="320" Minimum="-12" Maximum="12" Value="-0.5"/>
                <TextBlock Text="1 kHz" Style="{StaticResource StormTextBoldStyle}" HorizontalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Column="6" HorizontalAlignment="Center" Spacing="10">
                <Slider Orientation="Vertical" Height="320" Minimum="-12" Maximum="12" Value="1.5"/>
                <TextBlock Text="2 kHz" Style="{StaticResource StormTextBoldStyle}" HorizontalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Column="7" HorizontalAlignment="Center" Spacing="10">
                <Slider Orientation="Vertical" Height="320" Minimum="-12" Maximum="12" Value="3"/>
                <TextBlock Text="4 kHz" Style="{StaticResource StormTextBoldStyle}" HorizontalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Column="8" HorizontalAlignment="Center" Spacing="10">
                <Slider Orientation="Vertical" Height="320" Minimum="-12" Maximum="12" Value="4"/>
                <TextBlock Text="8 kHz" Style="{StaticResource StormTextBoldStyle}" HorizontalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Column="9" HorizontalAlignment="Center" Spacing="10">
                <Slider Orientation="Vertical" Height="320" Minimum="-12" Maximum="12" Value="5"/>
                <TextBlock Text="16 kHz" Style="{StaticResource StormTextBoldStyle}" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>

